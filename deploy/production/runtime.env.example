# Copy outside the checkout, mode 0600. Plain KEY=value, no quoting or expansion.
# Use postgres@sha256:<digest of the approved official PostgreSQL 17 image>.
POSTGRES_IMAGE=
# Independent random values. For example generate each with openssl rand -hex 32.
POSTGRES_ADMIN_PASSWORD=
DB_PASSWORD=
API_SESSION_JWT_SECRET=
TELEGRAM_STAFF_CHAT_LINK_SECRET_PEPPER=
VENUE_STAFF_INVITE_SECRET_PEPPER=
BILLING_WEBHOOK_SECRET=
# Keep disabled through the infrastructure/restore rehearsal.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
PLATFORM_OWNER_TELEGRAM_ID=
TELEGRAM_MAIN_MINI_APP_CONFIGURED=false
