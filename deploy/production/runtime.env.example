# Copy outside the checkout, mode 0600. Plain KEY=value, no quoting or expansion.
# Use postgres@sha256:<digest of the approved official PostgreSQL 17 image>.
POSTGRES_IMAGE=
# Independent random values. For example generate each with openssl rand -hex 32.
POSTGRES_ADMIN_PASSWORD=
DB_PASSWORD=
API_SESSION_JWT_SECRET=
TELEGRAM_STAFF_CHAT_LINK_SECRET_PEPPER=
VENUE_STAFF_INVITE_SECRET_PEPPER=
BILLING_WEBHOOK_SECRET=
# Disabled for an infrastructure rehearsal. For initial signed login, admit the verified
# production token and owner while HTTPS is still closed. Recovery may defer this check.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
PLATFORM_OWNER_TELEGRAM_ID=
TELEGRAM_MAIN_MINI_APP_CONFIGURED=false
# Set true only with a private EU bucket and a dedicated bucket-scoped R2 token.
PRODUCTION_MEDIA_ENABLED=false
STAFF_PHOTOS_R2_BUCKET=
STAFF_PHOTOS_R2_ENDPOINT=
STAFF_PHOTOS_R2_REGION=
STAFF_PHOTOS_R2_JURISDICTION=
STAFF_PHOTOS_R2_ACCESS_KEY=
STAFF_PHOTOS_R2_SECRET_KEY=
